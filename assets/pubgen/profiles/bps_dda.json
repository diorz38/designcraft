    "include_inside_cover": true,
    "include_back_cover": true
  },
  "nomenclature": {
    "chapter_prefix": "BAB",
    "table_prefix": "Tabel",
    "chart_prefix": "Grafik",
    "toc_title": "Daftar Isi",
    "list_tables_title": "Daftar Tabel",
    "list_charts_title": "Daftar Grafik",
    "source_labels": [
      "Sumber:",
      "Source:",
      "Sumber / Source:"
    ],
    "note_labels": [
      "Catatan:",
      "Note:",
      "Catatan / Note:",
      "Keterangan:"
    ]
  },
  "sheet_routing": {
    "cover_patterns": [
      "(?i)^cover$",
      "(?i)^sampul$"
    ],
    "divider_patterns": [
      "(?i)^div.*",
      "(?i)^pembatas.*"
    ],
    "narrative_patterns": [
      "(?i)^r\\d+.*",
      "(?i)^ulasan.*"
    ],
    "table_patterns": [
